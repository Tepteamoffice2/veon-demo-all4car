---
// Functional line icons only (phone, messengers, mail, menu). Decorative: aria-hidden.
interface Props { name: "phone" | "viber" | "telegram" | "mail" | "menu" | "close" | "down"; class?: string; }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5 3.5h3.2l1.6 4-2.1 1.3a11 11 0 0 0 5.5 5.5l1.3-2.1 4 1.6V17a2 2 0 0 1-2 2A15.5 15.5 0 0 1 3 5.5a2 2 0 0 1 2-2Z" />}
  {name === "viber" && <><path d="M12 3c4.6 0 8 1.4 8 7.5S16.6 18 12 18c-.8 0-1.6 0-2.3-.2L6.5 20.5V17C4.6 15.8 4 13.6 4 10.5 4 4.4 7.4 3 12 3Z" /><path d="M9.4 7.6c.3-.3.8-.3 1 .1l.7 1.2c.2.3.1.7-.2.9l-.4.3c.4 1 1.2 1.8 2.2 2.2l.3-.4c.2-.3.6-.4.9-.2l1.2.7c.4.2.4.7.1 1-.6.7-1.5.9-2.3.5a7 7 0 0 1-3.9-3.9c-.3-.8-.2-1.7.4-2.4Z" /></>}
  {name === "telegram" && <path d="M21 4 3 11.2l5.6 2L18 7l-7.4 7.6v5.1l3.2-3.4 4.4 3.2L21 4Z" />}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "down" && <path d="M12 5v14m-6-6 6 6 6-6" />}
</svg>

---
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import { contacts } from "../data/site";

const paths = [
  { id: "artykul", tab: "артикул", figure: "48069‑33070", figureNote: "так виглядає артикул" },
  { id: "marka", tab: "марку", figure: "24", figureNote: "марки в оригінальних каталогах" },
  { id: "vin", tab: "тільки VIN", figure: "17", figureNote: "знаків у VIN-коді" },
];
---
<section id="pidbir" class="sec pidbir" data-rec="U-R003" aria-labelledby="pidbir-title">
  <div class="container">
    <SectionHead id="pidbir" title="Для тих, хто не знає артикул" lead="Оберіть, що вам відомо, і ми підкажемо найкоротший шлях до потрібної деталі." />

    <div class="tabs" data-tabs>
      <div class="tabs__bar">
        <span class="tabs__say" id="pidbir-say">Я знаю</span>
        <div class="tabs__list" role="tablist" aria-labelledby="pidbir-say">
          {paths.map((p) => (
            <button class="tabs__tab" type="button" role="tab" id={`tab-${p.id}`} aria-controls={`panel-${p.id}`}
              aria-selected={p.id === "vin" ? "true" : "false"} tabindex={p.id === "vin" ? "0" : "-1"}>{p.tab}</button>
          ))}
          <span class="tabs__ind" aria-hidden="true" data-ind></span>
        </div>
      </div>

      {paths.map((p) => (
        <div class="panel" role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} data-panel={p.id} tabindex="0">
          <p class="panel__figure num" aria-hidden="true">{p.figure}<span>{p.figureNote}</span></p>
          <div class="panel__body">
            {p.id === "artykul" && (
              <>
                <h3 class="panel__title">Знаю артикул</h3>
                <p>Введіть номер деталі в поле пошуку на початку сторінки. Шукаємо оригінал і аналоги: за артикулом, брендом, назвою або VIN.</p>
                <p class="panel__muted">Поки пошук готується до запуску, наявність і ціну за артикулом назве менеджер.</p>
                <div class="panel__actions">
                  <a class="btn btn--line" href="#hero">До поля пошуку</a>
                  <a class="btn btn--call" href={contacts.phoneMain.href}><Icon name="phone" />Уточнити за телефоном</a>
                </div>
              </>
            )}
            {p.id === "marka" && (
              <>
                <h3 class="panel__title">Знаю марку авто</h3>
                <p>Оригінальні електронні каталоги для 24 марок, від Audi до VW, а також загальні каталоги аналогів, мотокаталоги й розділи для авто зі США.</p>
                <div class="panel__actions">
                  <a class="btn btn--line" href="#katalogy">Перейти до каталогів</a>
                </div>
              </>
            )}
            {p.id === "vin" && (
              <>
                <h3 class="panel__title">Знаю тільки VIN</h3>
                <p>VIN-код має 17 знаків, він вказаний у техпаспорті авто. Надішліть його менеджеру: підберемо деталь і надішлемо ціни.</p>
                <div class="panel__actions">
                  <a class="btn btn--call" href={contacts.phoneMain.href}><Icon name="phone" />Продиктувати VIN</a>
                  <a class="btn btn--line" href={contacts.viber.href}><Icon name="viber" />Viber</a>
                  <a class="btn btn--line" href={contacts.telegram.href}><Icon name="telegram" />Telegram</a>
                  <a class="btn btn--line" href={contacts.email.href}><Icon name="mail" />На e-mail</a>
                </div>
              </>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pidbir { border-top: 1px solid var(--color-line); }
  .tabs__bar { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s2) var(--s3); padding-bottom: var(--s3); border-bottom: 2px solid var(--color-text); }
  .tabs__say { font-family: var(--font-display); font-weight: 500; font-size: var(--fs-lg); color: var(--color-muted); }
  .tabs__list { position: relative; display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4); }
  .tabs__tab {
    position: relative; min-height: var(--tap); padding: 0; border: 0; background: none; cursor: pointer;
    font-family: var(--font-display); font-weight: 700; font-size: var(--fs-xl); line-height: 1.1; color: var(--color-muted);
    text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 8px; text-decoration-color: var(--color-line);
    transition: color var(--dur-fast) var(--ease-out), text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .tabs__tab:hover { color: var(--color-text); text-decoration-color: var(--color-text); }
  .tabs__tab[aria-selected="true"] { color: var(--color-text); text-decoration-color: transparent; }
  .tabs__ind {
    position: absolute; left: 0; top: 100%; width: 14px; height: 14px; background: var(--color-accent);
    transform: translateX(var(--x, 0px)); transition: transform 250ms var(--ease-out);
  }
  :global(.js) .tabs__ind:not(.is-ready) { opacity: 0; }
  html:not(.js) .tabs__bar { display: none; }

  .panel { display: grid; gap: var(--s4); padding-block: var(--s6) 0; outline-offset: 4px; }
  .panel[hidden] { display: none; }
  :global(.js) .panel.is-in { animation: panel-in 200ms var(--ease-out); }
  @keyframes panel-in { from { opacity: 0; } to { opacity: 1; } }
  .panel__figure {
    display: grid; align-content: start; gap: var(--s1);
    font-family: var(--font-display); font-weight: 700; font-size: clamp(3rem, 1.6rem + 6vw, 7rem); line-height: .95; letter-spacing: -0.03em;
    overflow-wrap: anywhere; min-width: 0;
  }
  .panel__figure span { font-family: var(--font-body); font-weight: 500; font-size: var(--fs-body); letter-spacing: 0; color: var(--color-muted); }
  #panel-artykul .panel__figure { font-size: clamp(2rem, 1rem + 4vw, 4.5rem); }
  .panel__body { display: grid; gap: var(--s2); align-content: start; max-width: 40rem; font-size: var(--fs-lg); line-height: 1.45; }
  .panel__title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-lg); }
  :global(.js) .panel__title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .panel__muted { color: var(--color-muted); font-size: var(--fs-body); }
  .panel__actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s1); padding-top: var(--s2); max-width: 32rem; }
  html:not(.js) .panel + .panel { border-top: 1px solid var(--color-line); margin-top: var(--s6); }

  @media (min-width: 900px) {
    .panel { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--gap); }
  }
  @media (max-width: 419px) {
    .panel__actions { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 599px) {
    .tabs__tab { font-size: var(--fs-lg); }
    .tabs__list { gap: var(--s1) var(--s3); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tabs__ind { transition: none; }
    :global(.js) .panel.is-in { animation: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-tabs]");
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[role=tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[role=tabpanel]"));
    const ind = root.querySelector<HTMLElement>("[data-ind]");
    const place = (tab: HTMLElement) => {
      if (!ind) return;
      ind.style.setProperty("--x", `${tab.offsetLeft}px`);
      ind.style.top = `${tab.offsetTop + tab.offsetHeight + 4}px`;
      ind.classList.add("is-ready");
    };
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => { const on = t === tab; t.setAttribute("aria-selected", String(on)); t.tabIndex = on ? 0 : -1; });
      panels.forEach((p) => {
        const on = p.id === tab.getAttribute("aria-controls");
        p.hidden = !on;
        p.classList.toggle("is-in", on);
      });
      place(tab);
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", (e) => {
        let n = -1;
        if (e.key === "ArrowRight") n = (i + 1) % tabs.length;
        else if (e.key === "ArrowLeft") n = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === "Home") n = 0;
        else if (e.key === "End") n = tabs.length - 1;
        if (n >= 0) { e.preventDefault(); select(tabs[n], true); }
      });
    });
    const current = tabs.find((t) => t.getAttribute("aria-selected") === "true") || tabs[0];
    select(current);
    root.querySelectorAll(".panel").forEach((p) => p.classList.remove("is-in"));
    const replace = () => { const t = tabs.find((x) => x.getAttribute("aria-selected") === "true"); if (t) place(t); };
    window.addEventListener("resize", replace);
    document.fonts?.ready.then(replace);
    if ("ResizeObserver" in window) new ResizeObserver(replace).observe(root.querySelector(".tabs__list") as Element);
  }
</script>

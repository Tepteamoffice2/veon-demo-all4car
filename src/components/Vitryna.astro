---
import { Picture } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import { products, pricesDate, contacts } from "../data/site";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/products/*.jpg", { eager: true });
const imgOf = (name: string) => images[`../assets/products/${name}.jpg`].default;
---
<section id="vitryna" class="sec vitryna" data-rec="U-R013" aria-labelledby="vitryna-title">
  <div class="container">
    <SectionHead id="vitryna" title="Для прикладу — що є на вітрині зараз" />

    <ul class="tags" tabindex="0" aria-label="Товари з вітрини, прокручується вбік">
      {products.map((p) => (
        <li class="tag">
          <article class="tag__body">
            <div class="tag__img">
              <Picture src={imgOf(p.img)} formats={["avif", "webp"]} widths={[280, 420, 560]}
                sizes="(min-width: 1280px) 296px, (min-width: 900px) 23vw, 72vw"
                alt={`${p.name}, артикул ${p.code}`} loading="lazy" decoding="async" />
            </div>
            <p class="tag__code num">{p.code}</p>
            <h3 class="tag__name">{p.name}</h3>
            <p class="tag__brand">{p.brand}</p>
            <p class="tag__price num">{p.price}<span> грн</span></p>
          </article>
        </li>
      ))}
    </ul>

    <div class="vit__foot">
      <p class="vit__note">Ціни з вітрини магазину на {pricesDate}. Наявність і актуальну ціну уточнюйте в менеджера.</p>
      <a class="btn btn--line" href={contacts.phoneMain.href}><Icon name="phone" />Уточнити наявність</a>
    </div>
  </div>
</section>

<style>
  .vitryna { padding-top: 0; }
  .tags {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap);
    border-top: 2px solid var(--color-text); padding-top: var(--s3); outline-offset: 4px;
  }
  .tag__body { display: grid; gap: var(--s1); align-content: start; height: 100%; }
  .tag__img { aspect-ratio: 1 / 1; background: var(--color-bg); border: 1px solid var(--color-line); overflow: hidden; margin-bottom: var(--s1); }
  .tag__img :global(img) { width: 100%; height: 100%; object-fit: contain; padding: var(--s2); }
  .tag__code { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-lg); line-height: 1.15; letter-spacing: -0.01em; }
  .tag__name { font-family: var(--font-body); font-weight: 500; font-size: var(--fs-body); line-height: 1.35; min-height: calc(2 * 1.35em); }
  .tag__brand { color: var(--color-muted); font-size: var(--fs-sm); }
  .tag__price { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-xl); line-height: 1.1; padding-top: var(--s1); border-top: 1px solid var(--color-line); margin-top: auto; }
  .tag__price span { font-size: var(--fs-body); font-weight: 500; }
  .vit__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s2) var(--s4); margin-top: var(--s5); }
  .vit__note { color: var(--color-muted); max-width: 36rem; }

  @media (max-width: 899px) {
    .tags {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 72%;
      overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
      padding-bottom: var(--s2); scrollbar-width: thin;
    }
    .tag { scroll-snap-align: start; }
  }
  @media (min-width: 600px) and (max-width: 899px) {
    .tags { grid-auto-columns: 42%; }
  }
</style>
